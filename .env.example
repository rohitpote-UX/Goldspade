# ============================================================
# GOLDSPADE DIGITAL STUDIO — ENVIRONMENT CONFIGURATION
# Copy to .env.local for local development or configure in Vercel.
# ============================================================

# 1. Site Configuration
NEXT_PUBLIC_SITE_URL=https://goldspade.in

# 2. Contact Form Recipient
CONTACT_RECEIVER_EMAIL=hello@goldspade.in

# 3. SMTP Configuration (GoDaddy / Titan Email)
# Required for sending emails to hello@goldspade.in
# Titan SMTP: smtp.titan.email (port 465 SSL, 587 TLS)
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=hello@goldspade.in
SMTP_PASSWORD=

# 4. Fallback Email API (Resend — optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# 5. Admin Portal Credentials (Internal CRM)
ADMIN_DEFAULT_EMAIL=admin@goldspade.in
ADMIN_INITIAL_PASSWORD=Goldspade@Admin2026!
ADMIN_DEFAULT_NAME=Goldspade Administrator

# 6. Session Encryption Secret Key
# Generate a 32+ character random string
NEXTAUTH_SECRET=goldspade_production_secure_secret_key_2026_x89f
AUTH_SECRET=goldspade_production_secure_secret_key_2026_x89f

# 7. Production Database Connection (PostgreSQL — optional)
DATABASE_URL=
